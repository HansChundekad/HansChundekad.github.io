---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Pen from '../components/Pen.astro';
import { profile, bullets, work, projects, awards } from '../data/content';

const nav = [
  { id: 'work', label: 'Work' },
  { id: 'projects', label: 'Projects' },
  { id: 'awards', label: 'Awards' },
];
const initials = profile.name
  .split(' ')
  .map((w) => w[0])
  .join('');
let hlIndex = 0;
---

<Base
  title="Hans Chundekad · Software Engineer"
  description="Hans Chundekad: Computer Science with Business Applications at UC Riverside. 3x hackathon winner building AI agents, full-stack apps, and embedded systems."
>
  <header class="topbar" id="topbar">
    <div class="topbar__inner col">
      <a class="topbar__name" href="#top" aria-label="Back to top">{profile.name}</a>
      <nav class="topbar__nav" aria-label="Sections">
        {nav.map((n) => <a href={`#${n.id}`} data-jump>{n.label}</a>)}
      </nav>
      <div class="topbar__tools">
        <div class="topbar__links">
          <a class="icon-btn" href={`mailto:${profile.email}`} aria-label="Email" target="_blank" rel="noopener"><Icon name="mail" /></a>
          <a class="icon-btn" href={profile.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener"><Icon name="linkedin" /></a>
          <a class="icon-btn" href={profile.github} aria-label="GitHub" target="_blank" rel="noopener"><Icon name="github" /></a>
        </div>
        <a class="btn btn--ink btn--sm topbar__resume" href={profile.resume} target="_blank" rel="noopener"><Icon name="file" />Resume</a>
        <button class="icon-btn theme-toggle topbar__theme" type="button" aria-label="Toggle dark mode" data-theme-toggle>
          <Icon name="sun" class="i-sun" /><Icon name="moon" class="i-moon" />
        </button>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="hero col" aria-label="Introduction">
      <div class="hero__head">
        <div class="avatar" data-rise>
          {profile.photo ? <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="272" height="272" /> : <span aria-hidden="true">{initials}</span>}
        </div>
        <div>
          <div class="name-slot" id="name-slot">
            <h1><span class="name-text">{profile.name}</span></h1>
            <div class="vara-layer" id="vara-greet" aria-hidden="true"></div>
            <div class="vara-layer" id="vara-name" aria-hidden="true"></div>
          </div>
          <p class="hero__degree" data-rise>
            {profile.degree} @ <a class="dot-link" href={profile.schoolUrl} target="_blank" rel="noopener">{profile.school}</a>
            <span class="muted"> · {profile.gradYear}</span>
          </p>
        </div>
      </div>

      <ul class="bullets">
        {
          bullets.map((line) => (
            <li data-rise>
              <span>
                {line.map((seg) => {
                  if (typeof seg === 'string') return seg;
                  const i = hlIndex++;
                  return seg.href ? (
                    <a class="hl" data-hl={seg.hl} href={seg.href} data-jump style={`--i:${i}`}>
                      {seg.text}
                    </a>
                  ) : (
                    <span class="hl" data-hl={seg.hl} style={`--i:${i}`}>
                      {seg.text}
                    </span>
                  );
                })}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="hero__seeking" data-rise>{profile.seeking}</p>

      <p class="contact-row" data-rise>
        <a class="btn btn--ink btn--sm contact-row__resume" href={profile.resume} target="_blank" rel="noopener"><Icon name="file" />Resume</a>
        <a href={`mailto:${profile.email}`} target="_blank" rel="noopener"><Icon name="mail" />{profile.email}</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={profile.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={profile.github} target="_blank" rel="noopener"><Icon name="github" />GitHub</a>
      </p>

      <nav class="bignav" id="bignav" aria-label="Sections" data-rise>
        {nav.map((n) => <a href={`#${n.id}`} data-jump>{n.label}</a>)}
        <button class="icon-btn theme-toggle bignav__theme" type="button" aria-label="Toggle dark mode" data-theme-toggle>
          <Icon name="sun" class="i-sun" /><Icon name="moon" class="i-moon" />
        </button>
      </nav>
    </section>

    <section class="section col" id="work" aria-labelledby="work-title">
      <h2 class="section__title" id="work-title">Work</h2>
      <div class="section__body grid">
        {
          work.map((job, i) => (
            <article class="card job" id={`work-${job.id}`} data-reveal="card">
              <a class="card__media" href={job.url} target="_blank" rel="noopener" aria-label={`${job.company} website`}>
                <img src={job.logo} alt="" loading="lazy" width="1600" height="1000" />
              </a>
              <div class="card__head">
                <h3 class="card__name">
                  <a class="penned card__title-link" href={job.url} target="_blank" rel="noopener">
                    {job.role}
                    <Pen kind="under" variant={i % 3 as 0 | 1 | 2} />
                  </a>
                </h3>
                <span class="when" title={job.dates}>
                  {job.when}
                  <Pen kind="loop" variant={i % 3 as 0 | 1 | 2} />
                </span>
              </div>
              <p class="card__event">
                {job.company} · {job.program} · {job.place}
              </p>
              <div class="card__links">
                <a href={job.url} target="_blank" rel="noopener">
                  Website
                  <Icon name="arrow" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section col" id="projects" aria-labelledby="projects-title">
      <h2 class="section__title" id="projects-title">Projects</h2>
      <div class="section__body grid">
        {
          projects.map((p, i) => (
            <article class={`card${p.links[0] ? ' card--link' : ''}`} id={`project-${p.id}`} data-reveal="card">
              {p.links[0] && <a class="card__overlay" href={p.links[0].href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true" />}
              <div class="card__media">
                {p.image && <img src={p.image} alt={`Screenshot of ${p.name}`} loading="lazy" width="1600" height="1000" />}
                                {p.cover === 'clineshield' && (
                  <div class="cover cover--clineshield" aria-hidden="true">
                    <span class="cover__label">illustration</span>
                    <div class="cs" data-cs>
                      <div class="cs__stage" data-cs-stage>
                        <div class="cs__title">
                          <i /><i /><i />
                          <span>billing-service · Visual Studio Code</span>
                        </div>
                        <div class="cs__body">
                          <div class="cs__activity">
                            <b /><b /><b class="on" /><b />
                          </div>
                          <aside class="cs__side">
                            <p class="cs__h">ClineShield</p>
                            <dl class="cs__stats">
                              <div><dt>Edits blocked</dt><dd data-cs-blocked>2</dd></div>
                              <div><dt>Edits allowed</dt><dd>41</dd></div>
                              <div><dt>Needs approval</dt><dd>5</dd></div>
                              <div class="cs__risk">
                                <dt>Risk score</dt>
                                <dd><span data-cs-risk>38</span></dd>
                                <span class="cs__bar"><s data-cs-riskbar /></span>
                              </div>
                            </dl>
                            <p class="cs__h cs__h--sm">Files touched</p>
                            <div class="cs__heat"><i style="--h:0.15"></i><i style="--h:0.3"></i><i style="--h:0.05"></i><i style="--h:0.6"></i><i style="--h:0.2"></i><i style="--h:0.1"></i><i style="--h:0.45"></i><i style="--h:0.25"></i><i style="--h:0.8" data-cs-hot></i><i style="--h:0.1"></i><i style="--h:0.35"></i><i style="--h:0.05"></i><i style="--h:0.2"></i><i style="--h:0.55"></i><i style="--h:0.15"></i><i style="--h:0.4"></i><i style="--h:0.1"></i><i style="--h:0.25"></i><i style="--h:0.65"></i><i style="--h:0.3"></i><i style="--h:0.05"></i><i style="--h:0.2"></i><i style="--h:0.5"></i><i style="--h:0.15"></i></div>
                            <ul class="cs__files">
                              <li><s class="hot" />billing.ts</li>
                              <li><s style="--h:0.55" />invoice.ts</li>
                              <li><s style="--h:0.3" />auth.ts</li>
                            </ul>
                          </aside>
                          <div class="cs__main">
                            <div class="cs__tabs"><span class="on">billing.ts</span><span>invoice.ts</span></div>
                            <div class="cs__code">
                              <p><u>12</u>export class Billing {"{"}</p>
                              <p data-cs-del><u>13</u>  charge(user, amount) {"{"} … {"}"}</p>
                              <p data-cs-del><u>14</u>  refund(id) {"{"} … {"}"}</p>
                              <p data-cs-del><u>15</u>  invoice(month) {"{"} … {"}"}</p>
                              <p data-cs-del><u>16</u>  retryFailed() {"{"} … {"}"}</p>
                              <p><u>17</u>{"}"}</p>
                            </div>
                            <div class="cs__term" data-cs-term>
                              <p class="cs__termbar">Cline</p>
                              <p data-cs-line>› Cleaning up billing: removing unused helpers</p>
                              <p data-cs-line class="dim">apply_patch src/billing.ts · −4 functions · 82% rewritten</p>
                              <div class="cs__shield" data-cs-shield>
                                <b>ClineShield</b> destructive change
                                <span>Deletes 4 functions (limit 3). Edit blocked; retry with smaller edits.</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
                {p.cover === 'triage' && (
                  <div class="cover cover--triage" aria-hidden="true">
                    <span class="cover__label">illustration</span>
                    <div class="tl" data-triage-log>
                      <div class="tl__head">
                        <span class="tl__title">App goes blank when deleting the last task</span>
                        <span class="tl__status" data-status>running</span>
                      </div>
                      <ol class="tl__log">
                        <li><b>ParserAgent</b> <i>@Repro</i> extracted 2 steps: Delete, confirm</li>
                        <li class="tl__sub"><em>Repro</em> navigate → list is empty</li>
                        <li><b>ReproAgent</b> <i>@Hypothesis</i> NOT REPRODUCED</li>
                        <li><b>HypothesisAgent</b> <i>@Parser</i> create a task before deleting</li>
                        <li><b>ParserAgent</b> <i>@Repro</i> type task → Add → Delete → confirm</li>
                        <li class="tl__sub"><em>Repro</em> click Delete → confirm → page went blank</li>
                        <li class="tl__sub tl__err"><em>Repro</em> TypeError: Cannot read properties of undefined (reading '0')</li>
                        <li><b>ReproAgent</b> <i>@Hypothesis</i> BUG REPRODUCED · attempt 2</li>
                        <li><b>HypothesisAgent</b> <i>@Repro</i> confirmed, matches the report</li>
                      </ol>
                    </div>
                  </div>
                )}
              </div>
              <div class="card__head">
                <h3 class="card__name">
                  {p.links[0] ? (
                    <a class="penned card__title-link" href={p.links[0].href} target="_blank" rel="noopener" aria-label={`${p.name} on ${p.links[0].label}`}>
                      {p.name}
                      <Pen kind="under" variant={(i + 1) % 3 as 0 | 1 | 2} />
                    </a>
                  ) : (
                    <span class="penned">
                      {p.name}
                      <Pen kind="under" variant={(i + 1) % 3 as 0 | 1 | 2} />
                    </span>
                  )}
                </h3>
                <span class="when">
                  {p.date}
                  <Pen kind="loop" variant={(i + 2) % 3 as 0 | 1 | 2} />
                </span>
              </div>
              {(p.event || p.status) && (
                <p class="card__event">
                  {p.event && <span>Built at {p.event}</span>}
                  {p.status && <span class="pill pill--go">{p.status}</span>}
                </p>
              )}
              <p class="card__tagline">{p.tagline}</p>
              {p.award && (
                <p class="card__award">
                  <Icon name="trophy" />
                  {p.award}
                </p>
              )}
              <p class="stack">{p.stack.join(' · ')}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section col" id="awards" aria-labelledby="awards-title">
      <h2 class="section__title" id="awards-title">Awards</h2>
      <div class="section__body awards">
        {
          awards.map((a) => (
            <a class="award" href={a.href} data-reveal="award" data-jump>
              <Icon name="trophy" class="award__trophy" />
              <span>
                <span class="award__event">{a.event}</span>
                <span class="award__prize" style="display:block">
                  <strong>{a.prize}</strong> · {a.project}
                </span>
              </span>
              <span class="award__year">{a.year}</span>
            </a>
          ))
        }
      </div>
      <p class="awards__more">
        Every hackathon build is on <a class="dot-link" href={profile.devpost} target="_blank" rel="noopener">Devpost</a>.
      </p>
    </section>
  </main>

  <footer class="footer col">
    <div class="footer__sign">
      <div class="fallback" aria-hidden="true">Thanks!</div>
      <div class="vara-layer" id="vara-sign" aria-hidden="true"></div>
    </div>
    <p class="footer__lead">If you're hiring software engineering interns for 2027, I'd like to hear from you.</p>
    <div class="footer__cta">
      <a class="btn btn--ink" href={`mailto:${profile.email}`} target="_blank" rel="noopener"><Icon name="mail" />Email me</a>
      <a class="btn" href={profile.resume} target="_blank" rel="noopener"><Icon name="file" />Resume</a>
      <a class="btn" href={profile.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a>
      <a class="btn" href={profile.github} target="_blank" rel="noopener"><Icon name="github" />GitHub</a>
    </div>
    <div class="footer__fine">
      <span>© 2026 {profile.name}</span>
      <span>Built with Astro & GSAP · Riverside, CA</span>
    </div>
  </footer>

  <p class="intro-hint" id="intro-hint" aria-hidden="true"><Icon name="volume-on" />Click anywhere for sound</p>
  <canvas class="trail" id="trail" aria-hidden="true"></canvas>

  <script>
    import { boot } from '../scripts/main';
    boot();
  </script>
</Base>
