---
import mail from 'lucide-static/icons/mail.svg?raw';
import fileText from 'lucide-static/icons/file-text.svg?raw';
import sun from 'lucide-static/icons/sun.svg?raw';
import moon from 'lucide-static/icons/moon.svg?raw';
import trophy from 'lucide-static/icons/trophy.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import shieldX from 'lucide-static/icons/shield-x.svg?raw';
import volume2 from 'lucide-static/icons/volume-2.svg?raw';
import volumeX from 'lucide-static/icons/volume-x.svg?raw';
import { siGithub, siDevpost } from 'simple-icons';

interface Props {
  name: 'mail' | 'file' | 'sun' | 'moon' | 'trophy' | 'arrow' | 'shield-x' | 'volume-on' | 'volume-off' | 'github' | 'linkedin' | 'devpost';
  class?: string;
}

const { name, class: cls = '' } = Astro.props;

// LinkedIn's mark is no longer in simple-icons, so it is drawn here.
const linkedin =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const stroke: Record<string, string> = {
  mail,
  file: fileText,
  sun,
  moon,
  trophy,
  arrow: arrowUpRight,
  'shield-x': shieldX,
  'volume-on': volume2,
  'volume-off': volumeX,
};
const brand: Record<string, string> = { github: siGithub.path, devpost: siDevpost.path, linkedin };

const svg = stroke[name]
  ? stroke[name]
      .replace(/<!--[\s\S]*?-->/g, '')
      .replace(/class="[^"]*"/, `class="${cls}" aria-hidden="true" focusable="false"`)
      .replace(/stroke-width="2"/, 'stroke-width="1.8"')
  : `<svg class="${cls}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="${brand[name]}"/></svg>`;
---

<Fragment set:html={svg} />
