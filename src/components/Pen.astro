---
// Hand-drawn pen marks: a wavy underline for titles, a loose loop around dates.
interface Props {
  kind: 'under' | 'loop';
  variant?: 0 | 1 | 2;
}
const { kind, variant = 0 } = Astro.props;

const under = [
  'M2 7 C 22 3, 40 10, 64 6 S 104 3, 132 7 S 176 9, 198 5',
  'M3 6 C 30 9, 52 3, 86 6 S 140 9, 168 5 S 190 6, 197 8',
  'M2 8 C 26 4, 58 9, 92 5 S 150 4, 176 8 S 194 5, 198 6',
];
const loop = [
  'M22 5 C 62 1, 108 3, 115 21 C 120 41, 76 47, 34 46 C 9 45, 2 32, 5 18 C 8 7, 30 3, 56 6',
  'M28 4 C 70 2, 112 6, 116 25 C 118 43, 70 48, 30 45 C 7 43, 3 28, 7 15 C 11 5, 36 2, 60 4',
  'M16 8 C 52 1, 104 2, 114 18 C 121 38, 82 46, 40 47 C 10 47, 1 34, 4 20 C 7 9, 26 4, 48 5',
];
const d = kind === 'under' ? under[variant] : loop[variant];
const box = kind === 'under' ? '0 0 200 12' : '0 0 120 50';
---

<svg class={`pen pen--${kind}`} viewBox={box} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path d={d} pathLength="1" vector-effect="non-scaling-stroke"></path>
</svg>
